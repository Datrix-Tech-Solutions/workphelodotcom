# Base URL of the API gateway, including the version prefix.
# Optional: without it, `npm run dev` uses the dev server and a production build uses production.
# Dev:        https://dev-api.workphelo.com/api/v1
# Production: https://api.workphelo.com/api/v1
HR_API_URL=https://dev-api.workphelo.com/api/v1

# Supabase project used for candidate sign in / sign up (Settings → API).
# Only the publishable (anon) key belongs here; never the service-role key.
# If your host refuses NEXT_PUBLIC_ variables, use SUPABASE_URL and
# SUPABASE_PUBLISHABLE_KEY instead (Supabase is only used on the server).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Order emails (pricing page). Sent through Brevo. EMAIL_FROM must be a verified sender in Brevo.
# ORDER_NOTIFY_EMAIL is the WorkPhelo admin inbox that gets each new order request; separate several addresses with commas.
BREVO_API_KEY=
EMAIL_FROM=
ORDER_NOTIFY_EMAIL=sales@datrixtechsolutions.com

# Job alert emails (footer subscribe). Kept separate from the order emails above so the
# two can use different providers or senders later. For now use the same values.
JOB_ALERT_BREVO_API_KEY=
JOB_ALERT_EMAIL_FROM=
# Public address of the site, used for the links in alert emails (no trailing slash).
SITE_URL=https://workphelo.com
# Protects /api/cron/job-alerts. The scheduler must send `Authorization: Bearer <this>`
# (Vercel Cron does so automatically when CRON_SECRET is set). Use a long random string.
CRON_SECRET=

# Server-only key that lets the site write recruiters' adverts to Supabase (recruiters
# don't have a Supabase login). It bypasses row-level security: never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
