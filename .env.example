# Base URL of the API gateway, including the version prefix.
# Optional: without it, `npm run dev` uses the dev server and a production build uses production.
# Dev:        https://dev-api.workphelo.com/api/v1
# Production: https://api.workphelo.com/api/v1
HR_API_URL=https://dev-api.workphelo.com/api/v1

# Supabase project used for candidate sign in / sign up (Settings → API).
# Only the publishable (anon) key belongs here; never the service-role key.
# If your host refuses NEXT_PUBLIC_ variables, use SUPABASE_URL and
# SUPABASE_PUBLISHABLE_KEY instead (Supabase is only used on the server).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
