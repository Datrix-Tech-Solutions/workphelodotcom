# Base URL of the API gateway, including the version prefix.
# Optional: without it, `npm run dev` uses the dev server and a production build uses production.
# Dev:        https://dev-api.workphelo.com/api/v1
# Production: https://api.workphelo.com/api/v1
HR_API_URL=https://dev-api.workphelo.com/api/v1

# Supabase project used for candidate sign in / sign up (Settings → API).
# Only the publishable (anon) key belongs here; never the service-role key.
# If your host refuses NEXT_PUBLIC_ variables, use SUPABASE_URL and
# SUPABASE_PUBLISHABLE_KEY instead (Supabase is only used on the server).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Order emails (pricing page). Sent through Resend, the same service and sender the
# WorkPhelo platform uses. ORDER_NOTIFY_EMAIL is the WorkPhelo admin inbox that gets
# each new order request; separate several addresses with commas.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ORDER_NOTIFY_EMAIL=

# Server-only key that lets the site write recruiters' adverts to Supabase (recruiters
# don't have a Supabase login). It bypasses row-level security: never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
